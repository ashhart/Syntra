;; RENDEZVOUS BURN SEQUENCER — closed-loop real-time control capsule.
;;
;; The plant (harness) feeds live state every tick; this capsule delivers the
;; PREVIOUS tick's delayed feedback to the policy, then selects a burn
;; strategy under a fuel/rate Guard with a certified safe-hold fallback.
;;
;; Context per tick (array-of-pairs input):
;;   tick    tick index
;;   range_m distance to docking target (m)
;;   rate_ms closing rate (m/s, positive = closing)
;;   fuel_kg remaining propellant (kg)
;;   reward  shaped outcome of the previous tick; -1000 on the first tick
;; Burn strategies (the AdaptiveChoice options):
;;   0 coast-only
;;   1 coarse-far:   coarse burn far out, brake when closing fast
;;   2 fine:         fine burns mid-range, brake inside the soft corridor
;;   3 brake-hold:   brake every tick
;; Guard: fuel at reserve or runaway rate deopts to safe-hold (brake).
;; Trace note: the !p line prints range/rate/fuel scaled ×100 as compact
;; integers for the trace hash — "rate 39" means 0.39 m/s, "fuel 688" is 6.88 kg.

(F pick_burn (range rate)
  (B
    ($ choice (choice
      0
      (? (> range 60.0) 1 (? (> rate 1.0) 3 2))
      (? (> range 15.0) 2 (? (> rate 0.4) 3 2))
      3))
    choice))

($ tick   (!cap "runtime.inputGet" "tick"))
($ range  (!cap "runtime.inputGet" "range_m"))
($ rate   (!cap "runtime.inputGet" "rate_ms"))
($ fuel   (!cap "runtime.inputGet" "fuel_kg"))
($ reward (!cap "runtime.inputGet" "reward"))

;; Delayed feedback: credit the option that fired LAST tick with the outcome
;; observed since. One-tick delay, mirroring the product feedback path.
(? (> reward -900.0)
   (feedback choice reward)
   null)

;; Fail-closed selection: below propellant reserve or runaway closing rate,
;; the Guard deopts to the always-safe brake option.
(? (&& (> fuel 0.4) (< (!abs rate) 2.5))
   ($ burn (pick_burn range rate))
   ($ burn 3))

(!p "T" tick "range" (!round (* range 100.0)) "rate" (!round (* rate 100.0))
     "fuel" (!round (* fuel 100.0)) "burn" burn)

burn
