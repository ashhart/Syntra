{
  "name": "@syntra/client",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Syntra decision appliance (/v1 HTTP API).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "syntra",
    "bandit",
    "decision",
    "llm-routing",
    "sdk"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
